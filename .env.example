# ============================================================
# 部署环境变量模板（复制为 .env 并填写真实值，切勿提交 .env）
# 后端打包与部署使用方式：
#   Windows/裸机:   set FOX_DASHSCOPE_API_KEY=xxxx && java -jar ...
#   Docker 示例:    docker run -e SPRING_PROFILES_ACTIVE=prod -e FOX_DASHSCOPE_API_KEY=xxxx ...
#   FC 函数计算:    在控制台"环境变量"里逐项配置
# ============================================================

# ---- 必填 ----
# 阿里云百炼 API Key（https://dashscope.aliyun.com/apiKey）
FOX_DASHSCOPE_API_KEY=

# ---- 选填 ----
# 聊天模型（默认 kimi-k2.7-code；改 glm-5.2/qwen-plus 等时注意 FOX_MULTI_MODEL）
FOX_CHAT_MODEL=kimi-k2.7-code
# true=多模态接口(kimi/qwen3.8)；false=文本接口(glm-5.2)
FOX_MULTI_MODEL=true
# WebSearchTool 搜索 API Key（本地配置中 search-api.api-key 那项）
FOX_SEARCH_API_KEY=
# 图片搜索 MCP 服务地址 —— 仅当你启用了图片 MCP（取消 application-prod.yml 里 MCP 段注释）才需要。
# 微信云托管 / 单容器部署默认不启用图片 MCP，此项可留空。
MCP_IMAGE_SEARCH_URL=http://localhost:8127
# 高德 MCP Key（未启用，可留空）
FOX_AMAP_API_KEY=

# ---- 仅当需要 PostgreSQL / pgvector 时 ----
# 注意：开启 DB 需同步修改 application-prod.yml（取消 DataSource 排除并放开 datasource 段）
# FOX_PG_URL=jdbc:postgresql://你的库地址:5432/库名
# FOX_PG_USERNAME=xxx
# FOX_PG_PASSWORD=xxx
